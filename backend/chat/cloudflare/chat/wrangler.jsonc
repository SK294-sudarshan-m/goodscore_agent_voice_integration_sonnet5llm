{
  "name": "goodscore-chat-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  // Non-secret config. Fill in GOODSCORE_STAGE_BASE_URL with the
  // mock-api Worker's URL once it's deployed (see ../mock-api), and
  // EXTRA_CORS_ORIGIN with the Pages frontend URL once that's deployed.
  // ANTHROPIC_API_KEY is NOT here — it's a secret, set via the
  // dashboard (Settings > Variables and Secrets) or `wrangler secret put`.
  //
  // IMPORTANT: "goodscore-chat-backend" is the actual, live container
  // name (confirmed via `wrangler containers list` — STATE: active).
  // It matches the Worker's CI/dashboard-assigned project name, which
  // is what Cloudflare actually uses when creating the container —
  // NOT necessarily whatever this field said in earlier attempts (the
  // build log's "plan" preview echoes this field, but isn't always
  // what gets created; verify against `containers list`, not the log,
  // if this ever seems to disagree again). Do NOT rename this once
  // deployed — it's permanently bound to this Worker's Durable Object,
  // and a mismatch here is what caused repeated
  // "DURABLE_OBJECT_ALREADY_HAS_APPLICATION" failures.
  "vars": {
    "ANTHROPIC_MODEL_ID": "claude-sonnet-5",
    "GOODSCORE_STAGE_BASE_URL": "https://goodscore-agent-voice-integration-sonnet5llm.sudarshan-m.workers.dev",
    "EXTRA_CORS_ORIGIN": "REPLACE_WITH_PAGES_URL"
  },
  "containers": [
    {
      "class_name": "ChatContainer",
      "image": "../../Dockerfile.cloudflare",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_CONTAINER", "class_name": "ChatContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatContainer"] }
  ]
}

{
  "name": "goodscore-chat-backend",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  // Non-secret config. Fill in GOODSCORE_STAGE_BASE_URL with the
  // mock-api Worker's URL once it's deployed (see ../mock-api), and
  // EXTRA_CORS_ORIGIN with the Pages frontend URL once that's deployed.
  // ANTHROPIC_API_KEY is NOT here — it's a secret, set via the
  // dashboard (Settings > Variables and Secrets) or `wrangler secret put`.
  //
  // IMPORTANT: this "name" field is what actually names the container
  // application (name + "-<class_name lowercased>", e.g.
  // "goodscore-chat-app-chatcontainer") — NOT the dashboard/CI-assigned
  // Worker project name, which is a separate, independent identifier.
  // Once this has deployed successfully once, do NOT rename it — the
  // container application gets permanently bound to this Worker's
  // Durable Object, and renaming causes
  // "DURABLE_OBJECT_ALREADY_HAS_APPLICATION" (or, if the old container
  // app is still orphaned in the account, "already an application with
  // that name... associated with a different durable object
  // namespace") on the next deploy.
  "vars": {
    "ANTHROPIC_MODEL_ID": "claude-sonnet-5",
    "GOODSCORE_STAGE_BASE_URL": "https://goodscore-agent-voice-integration-sonnet5llm.sudarshan-m.workers.dev",
    "EXTRA_CORS_ORIGIN": "REPLACE_WITH_PAGES_URL"
  },
  "containers": [
    {
      "class_name": "ChatContainer",
      "image": "../../Dockerfile.cloudflare",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_CONTAINER", "class_name": "ChatContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatContainer"] }
  ]
}
